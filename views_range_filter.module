<?php

/**
 * @file
 * Hooks for the views_range_filter module.
 */

use Drupal\views\Plugin\views\filter\FilterPluginBase;


/**
 * Implements hook_views_filters_summary_info_alter().
 */
function views_range_filter_views_filters_summary_info_alter(array &$info, FilterPluginBase $filter): void {
  if (!in_array($filter->getPluginId(), ['views_range_filter_sapi', 'views_range_filter_sql'], TRUE)) {
    return;
  }

  $values = is_array($filter->value) ? $filter->value : [];
  $from   = trim((string) ($values['from'] ?? ''));
  $to     = trim((string) ($values['to']   ?? ''));

  if ($from === '' && $to === '') {
    $info['value'] = NULL;
    return;
  }

  if ($from !== '' && $to !== '') {
    $display = $from . ' – ' . $to;
  } elseif ($from !== '') {
    $display = '≥ ' . $from;
  } else {
    $display = '≤ ' . $to;
  }

  $info['value'] = [[
    'id'    => 0,
    'raw'   => $from . '|' . $to,
    'value' => $display,
  ]];
}